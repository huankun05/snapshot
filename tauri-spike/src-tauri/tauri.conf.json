{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "petalsnap-spike",
  "version": "0.1.0",
  "identifier": "com.petalsnap.spike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
